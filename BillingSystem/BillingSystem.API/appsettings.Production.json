{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<AWS SQL SERVER>;Database=<AWS DB>;User Id=db_user;Password=YOUR_SECURE_PASSWORD;TrustServerCertificate=True"
  },
  "JwtOptions": {
    "Issuer": "https://api.yourdomain.com",
    "Audience": "https://yourdomain.com",
    "Key": "AWS_JWT_PRODUCTION_SIGNING_KEY"
  },
  "AllowedOrigins": [
    "https://yourdomain.com"
  ],
  "EmailSettings": {
    "EnableEmailService": true,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "production@yourdomain.com",
    "SenderPassword": "PRODUCTION_SMTP_PASSWORD"
  },
  "StorageSettings": {
    "UploadRoot": "wwwroot/uploads"
  }
}
